# MinIO private document storage
MINIO_ENDPOINT=replace-with-private-minio-host
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=replace-with-minio-access-key
MINIO_SECRET_KEY=replace-with-minio-secret-key
# Or use MinIO's standard names from the server .env:
# MINIO_ROOT_USER=replace-with-minio-root-user
# MINIO_ROOT_PASSWORD=replace-with-minio-root-password
MINIO_BUCKET=tattvatech-private
MAX_UPLOAD_BYTES=10485760
